-- 2. 게임 전송 함수에 성공 판정 후 자동학습(dbHandler:autoLearn) 로직 연동
local lastAttemptedWord = ""

local function sendWordToGame(word)
    if word == "" then return end
    local targetBox = forceLoadGameTextBox()
    if not targetBox or not targetBox.Visible then return end
    
    lastAttemptedWord = word

    currentTypeSession = currentTypeSession + 1
    local mySession = currentTypeSession
    local targetRealSpeed = tonumber(config.typingSpeed) or 350

    if UserRank == "Premium" and config.antiBanEnabled then
        task.spawn(function()
            task.wait(1.0)
            pcall(function()
                if targetBox then
                    targetBox.Text = ""
                end
            end)
        end)
    end

    pcall(function()
        targetBox.Visible = true
        if targetBox.Parent and targetBox.Parent:IsA("GuiObject") then
            targetBox.Parent.Visible = true
        end
        targetBox:CaptureFocus()

        if targetRealSpeed <= 0 then
            if mySession ~= currentTypeSession then return end
            targetBox.Text = word
        else
            local totalStates = buildTypeStates(word)
            local delayTime = 60 / (targetRealSpeed * 2.8) 
            for _, partialText in ipairs(totalStates) do
                if mySession ~= currentTypeSession then return end
                targetBox.Text = partialText
                task.wait(delayTime)
            end
        end
        if mySession ~= currentTypeSession then return end
        task.wait(0.02)
        
        targetBox:ReleaseFocus(true)
        
        task.spawn(function()
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                if vim then
                    vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                end
            end)
        end)

        task.delay(0.6, function()
            if not isMyTurn() and lastAttemptedWord ~= "" then
                dbHandler:autoLearn(lastAttemptedWord)
                if not MainDictMap[lastAttemptedWord] then
                    MainDictMap[lastAttemptedWord] = true
                    table.insert(WordDB, lastAttemptedWord)
                end
                lastAttemptedWord = ""
            else
                print("[학습 스킵] 게임에서 거부된 단어:", lastAttemptedWord)
                lastAttemptedWord = ""
            end
        end)
    end)
end

-- 최적화된 승률 및 점수 계산 헬퍼 함수
local function calculateMatchWinRate(displayMatched, currentSearchText)
    if not config.winRateCalcEnabled or not config.readingEnabled then
        return 50
    end

    local attackCountTotal = 0
    local loopCountTotal = 0
    local totalMatched = #displayMatched

    if totalMatched == 0 then return 50 end

    -- 단일 루프로 공격/루프 단어 카운트 집계 (최적화)
    for i = 1, totalMatched do
        local targetW = displayMatched[i]
        if checkIsAttackWord(targetW) then 
            attackCountTotal = attackCountTotal + 1 
        end
        
        local lastChar = utf8.char(utf8.codepoint(targetW, -1, -1))
        if P_TIER2[lastChar] or P_TIER3[lastChar] then 
            loopCountTotal = loopCountTotal + 1 
        end
    end

    local currentWinRate = 50
    if attackCountTotal >= 7 or loopCountTotal >= 13 then
        currentWinRate = 15
    elseif (currentSearchText == "역스윕" or currentSearchText == "역") and (attackCountTotal >= 1 or loopCountTotal >= 2) then
        currentWinRate = 85
    else
        currentWinRate = currentWinRate - (attackCountTotal * 8) - (math.floor(loopCountTotal / 3) * 8)
        if attackCountTotal == 0 then currentWinRate = currentWinRate + 40 end
        if loopCountTotal == 0 then currentWinRate = currentWinRate + 30 end
    end

    return math.clamp(math.floor(currentWinRate), 0, 100)
end

